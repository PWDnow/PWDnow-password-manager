#include <tunables/global>

/usr/local/bin/vault-daemon flags=(enforce) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Vault file read/write
  /var/lib/vault-daemon/ rw,
  /var/lib/vault-daemon/** rw,

  # HIBP Cuckoo filter
  /var/lib/vault-daemon/*.cuckoo r,
  /var/lib/vault-daemon/*.cuckoo.sha256 r,

  # Runtime dir (sd_notify, pid, optional token file)
  /run/vault-daemon/ rw,
  /run/vault-daemon/** rw,

  # gRPC peer-auth token (env file, optional)
  /etc/vault-daemon/grpc.env r,

  # gRPC listener (loopback TCP). Replaces the former Unix-socket-only model.
  network inet  stream,
  network inet6 stream,

  # System libraries — specific filenames, glob only for arch suffix
  /usr/lib/@{multiarch}/libsodium.so.* mr,
  /usr/lib/@{multiarch}/libsqlcipher.so.* mr,
  /usr/lib/@{multiarch}/libfido2.so.* mr,
  /usr/local/lib/liboqs.so.* mr,

  # mlock() capability
  capability ipc_lock,

  # systemd sd_notify
  /run/systemd/notify rw,

  # Logging
  /dev/log w,

  # Explicitly deny dangerous access
  audit deny @{PROC}/sys/kernel/random/uuid r,
  deny /proc/*/mem rw,
  deny /proc/*/maps r,
  # Only inet/inet6 stream (gRPC) is permitted above; hard-deny everything else
  # (raw/packet sockets etc.). A blanket `deny network` would override the allows.
  deny network raw,
  deny network packet,
  deny /etc/shadow r,
  deny /etc/passwd r,
  deny /root/** rw,
}
