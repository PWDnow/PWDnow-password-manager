[Unit]
Description=Vault Daemon — local encrypted credential store
Documentation=https://github.com/your-org/vault-manager
After=local-fs.target
Requires=local-fs.target

[Service]
Type=notify
User=vault
Group=vault
# Phase 1 (horizontal-scalability migration): the daemon speaks gRPC, not a Unix
# socket. The peer-auth token is shared with the web proxy via this env file
# (create /etc/vault-daemon/grpc.env containing: DAEMON_GRPC_TOKEN=<32+ random hex>).
# The leading '-' makes the file optional (daemon self-generates a token otherwise).
EnvironmentFile=-/etc/vault-daemon/grpc.env
ExecStart=/usr/local/bin/vault-daemon --grpc-addr 127.0.0.1:50051 --vault /var/lib/vault-daemon/vault.db

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/vault-daemon /run/vault-daemon
NoExecPaths=/var /home /tmp /root
UMask=0077

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictNamespaces=true
# AF_INET/AF_INET6 required for the loopback gRPC listener (was AF_UNIX-only).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

MemoryDenyWriteExecute=true
MemorySwapMax=0
MemoryMax=2G
TasksMax=64

NoNewPrivileges=true
CapabilityBoundingSet=CAP_IPC_LOCK
AmbientCapabilities=CAP_IPC_LOCK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @swap @raw-io @cpu-emulation @keyring @clock @debug

RuntimeDirectory=vault-daemon
RuntimeDirectoryMode=0700
StateDirectory=vault-daemon
StateDirectoryMode=0700
WatchdogSec=30s
Restart=on-failure
RestartSec=5s
RestartForceExitStatus=42
LimitCORE=0
LimitNOFILE=4096

TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
