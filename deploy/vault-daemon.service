[Unit]
Description=Vault Daemon — local encrypted credential store
Documentation=https://github.com/your-org/vault-manager
After=local-fs.target
Requires=local-fs.target

[Service]
Type=notify
User=vault
Group=vault
ExecStart=/usr/local/bin/vault-daemon --socket /run/vault-daemon/vault.sock
RuntimeDirectory=vault-daemon
RuntimeDirectoryMode=0700
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictNamespaces=true
SystemCallFilter=@system-service @memlock
CapabilityBoundingSet=CAP_IPC_LOCK
AmbientCapabilities=CAP_IPC_LOCK

# Restart policy: always restart so the watchdog can trigger a restart too
Restart=always
RestartSec=5s
# Exit code 42 is reserved for "fatal, do restart immediately"
RestartForceExitStatus=42

# Watchdog: systemd kills and restarts the daemon if it goes 30 s without a
# heartbeat.  The daemon reads WATCHDOG_USEC and pings every WatchdogSec/3.
WatchdogSec=30s

# Graceful shutdown: give the daemon up to 10 s to flush state before SIGKILL.
TimeoutStopSec=10s

# Route logs to the journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
