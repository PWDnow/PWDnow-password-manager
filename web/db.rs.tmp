use rusqlite::{Connection, OpenFlags, params};
use std::path::Path;
use crate::error::VaultError;

pub const CURRENT_SCHEMA_VERSION: u32 = 1;

/// Open or create an SQLCipher-encrypted vault file.
/// `sqlcipher_key` is the 32-byte key (derived from VMK via HKDF in production;
/// a raw test key is used in unit tests).
pub fn open_vault(path: &Path, sqlcipher_key: &[u8; 32]) -> Result<Connection, VaultError> {
    let conn = Connection::open_with_flags(
        path,
        OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_CREATE,
    )?;

    // Must be the FIRST statement — sets the SQLCipher encryption key.
    // C-05 fix: assert the key is pure hex before interpolating into the PRAGMA
    // statement. hex::encode guarantees [0-9a-f], but this guard makes injection
    // impossible even if the derivation path ever changes.
    let hex_key = hex::encode(sqlcipher_key);
    debug_assert!(
        hex_key.chars().all(|c| c.is_ascii_hexdigit()),
        "sqlcipher key must be pure hex; got: {hex_key}"
    );
    if !hex_key.chars().all(|c| c.is_ascii_hexdigit()) {
        return Err(VaultError::Crypto("sqlcipher key is not valid hex".into()));
    }
    conn.execute_batch(&format!("PRAGMA key = \"x'{hex_key}'\";\n"))?;

    // D-05: explicit L5 security parameters (lock-in SQLCipher 4 defaults)
    conn.execute_batch("
        PRAGMA cipher = 'aes-256-cbc';
        PRAGMA kdf_iter = 256000;
        PRAGMA page_size = 4096;
        PRAGMA cipher_use_hmac = ON;
        PRAGMA cipher_hmac_algorithm = 'HMAC_SHA512';
        PRAGMA cipher_kdf_algorithm = 'PBKDF2_HMAC_SHA512';
    ")?;

    // Verify the key by reading from sqlite_master (fails fast on wrong key)
    conn.execute_batch("SELECT count(*) FROM sqlite_master;")?;

    // Architecture §5: WAL disabled when vault is locked
    conn.execute_batch("PRAGMA journal_mode = DELETE;")?;
    conn.execute_batch("PRAGMA foreign_keys = ON;")?;

    apply_migrations(&conn)?;
    Ok(conn)
}

/// Rotate the SQLCipher encryption key for an open vault connection.
pub fn rekey_vault(conn: &Connection, _old_key: &[u8; 32], new_key: &[u8; 32]) -> Result<(), VaultError> {
    let hex_key = hex::encode(new_key);
    // PRAGMA rekey expects the same hex-literal format as PRAGMA key.
    conn.execute_batch(&format!("PRAGMA rekey = \"x'{hex_key}'\";\n"))?;
    Ok(())
}

fn schema_version(conn: &Connection) -> Result<u32, VaultError> {
    let result: rusqlite::Result<u32> = conn.query_row(
        "SELECT value FROM vault_meta WHERE key = 'schema_version'",
        [],
        |r| r.get(0),
    );
    match result {
        Ok(v) => Ok(v),
        Err(rusqlite::Error::QueryReturnedNoRows) => Ok(0),
        // Table doesn't exist yet (new vault)
        Err(rusqlite::Error::SqliteFailure(_, _)) => Ok(0),
        Err(e) => Err(e.into()),
    }
}

fn apply_migrations(conn: &Connection) -> Result<(), VaultError> {
    let version = schema_version(conn)?;
    if version < 1 {
        migrate_v0_to_v1(conn)?;
    }
    Ok(())
}

fn migrate_v0_to_v1(conn: &Connection) -> Result<(), VaultError> {
    conn.execute_batch(include_str!("../../migrations/v1_initial.sql"))?;
    conn.execute(
        "INSERT OR REPLACE INTO vault_meta (key, value) VALUES ('schema_version', ?1)",
        params![CURRENT_SCHEMA_VERSION],
    )?;
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;
    use tempfile::NamedTempFile;

    fn dummy_key() -> [u8; 32] { [0xAAu8; 32] }

    #[test]
    fn test_create_and_open_vault() {
        let f = NamedTempFile::new().unwrap();
        let conn = open_vault(f.path(), &dummy_key()).unwrap();
        for table in &[
            "vault_meta", "users", "fido2_credentials", "otp_config",
            "folders", "credentials", "asset_holder", "audit_log",
        ] {
            let n: u32 = conn.query_row(
                "SELECT count(*) FROM sqlite_master WHERE type='table' AND name=?1",
                params![table],
                |r| r.get(0),
            ).unwrap();
            assert_eq!(n, 1, "table '{table}' missing from schema");
        }
    }

    #[test]
    fn test_schema_version_is_1_after_migration() {
        let f = NamedTempFile::new().unwrap();
        let conn = open_vault(f.path(), &dummy_key()).unwrap();
        let v: u32 = conn.query_row(
            "SELECT value FROM vault_meta WHERE key = 'schema_version'",
            [],
            |r| r.get(0),
        ).unwrap();
        assert_eq!(v, CURRENT_SCHEMA_VERSION);
    }

    #[test]
    fn test_wrong_key_fails() {
        let f = NamedTempFile::new().unwrap();
        // Create vault with key AA
        let _ = open_vault(f.path(), &[0xAAu8; 32]).unwrap();
        // Re-open with wrong key BB — should fail
        let result = open_vault(f.path(), &[0xBBu8; 32]);
        assert!(result.is_err(), "wrong SQLCipher key must not open vault");
    }

    #[test]
    fn test_max_fido2_credentials_enforced() {
        let f = NamedTempFile::new().unwrap();
        let conn = open_vault(f.path(), &dummy_key()).unwrap();
        // Insert 2 FIDO2 credentials (max allowed)
        for i in 0..2u32 {
            conn.execute(
                "INSERT INTO fido2_credentials
                 (id, credential_id, public_key_cbor, created_at)
                 VALUES (?1, ?2, ?3, ?4)",
                params![format!("id-{i}"), vec![i as u8; 16], vec![0u8; 32], 0i64],
            ).unwrap();
        }
        // Third insert must be rejected by the trigger
        let result = conn.execute(
            "INSERT INTO fido2_credentials
             (id, credential_id, public_key_cbor, created_at)
             VALUES ('id-3', X'AABBCCDD', X'DEADBEEF', 0)",
            [],
        );
        assert!(result.is_err(), "trigger must reject a 3rd FIDO2 credential");
    }
}
