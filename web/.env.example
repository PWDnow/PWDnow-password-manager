# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: The port the server runs on.
PORT=1234

# IPREGISTRY_API_KEY: Get a free key at https://ipregistry.co
# Leave blank to disable IP threat detection and blocking.
# When set, enables enriched audit log (city, region, country, ISP).
IPREGISTRY_API_KEY=

# IP Threat Blocking — configure which IP categories to block.
# Requires IPREGISTRY_API_KEY to be set; has no effect without it.
IP_BLOCK_TOR=true
IP_BLOCK_PROXY=true
IP_BLOCK_VPN=false
IP_BLOCK_ABUSER=true

# ── Payment Card Settings ─────────────────────────────────────────────────────
# VITE_ prefix = exposed to the browser bundle (non-secret UI config only)

# Maximum PAN digit count. Default 16. Amex auto-overrides to 15 via BIN detection.
VITE_PAN_LENGTH=16

# Trailing digits shown in the masked view (e.g. 3 → "XXXX XXXX XXXX X767"). Set to 0 for full mask.
VITE_PAN_UNHIDE=3

# Optional regex to override smart BIN-based PAN format validation.
# Leave empty to use built-in network detection (Visa, Mastercard, Amex, etc.).
# Example: ^[0-9]{13,19}$
VITE_PAN_FORMAT=

# Warn when a card expiry month-end is within this many days from today.
# Set to 0 to disable the soon-expiry warning.
VITE_CARD_EXPIRY_MIN_DAYS=5

# ── Browser Autofill ──────────────────────────────────────────────────────────
# Allow the browser's built-in password manager (Chrome, Firefox, etc.) to
# autofill credentials into PWDnow's own fields.
# Default: false — PWDnow is its own password manager; browser suggestions interfere.
# Set to true if you prefer the browser to offer autofill inside the app.
VITE_BROWSER_AUTOFILL=false
