//! DB helpers for the `otp_config` table — vault-level TOTP 2FA.
//!
//! The TOTP secret is encrypted with the VMK before storage so the plaintext
//! secret is never written to disk outside the encrypted SQLCipher file.
//!
//! The `confirmed` flag lives in `vault_meta` (key = `totp_confirmed`).
//! This avoids a schema migration: an unconfirmed setup leaves a row in
//! `otp_config` but `totp_confirmed` is absent or `0`.  Only when the user
//! provides the first valid code is the flag set to `1` and TOTP becomes
//! required at unlock.

use argon2::{
    password_hash::{PasswordHash, PasswordHasher, PasswordVerifier, SaltString},
    Argon2, Algorithm, Params, Version,
};
use rand_core::{OsRng, RngCore};
use rusqlite::{Connection, params};
use serde::{Deserialize, Serialize};
use uuid::Uuid;
use zeroize::Zeroize;

use crate::auth::totp;
use crate::crypto::xchacha20;
use crate::error::VaultError;

fn now() -> i64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs() as i64
}

/// A row from `otp_config` with the secret already decrypted.
#[derive(Debug)]
pub struct TotpConfig {
    pub id: String,
    /// Plaintext base32-encoded TOTP secret (zeroize after use).
    pub secret_b32: String,
    pub created_at: i64,
}

impl Drop for TotpConfig {
    fn drop(&mut self) {
        self.secret_b32.zeroize();
    }
}

/// Serialised form of what `SetupVaultTotp` returns to the client.
#[derive(Debug, Serialize, Deserialize)]
pub struct TotpSetupInfo {
    pub secret_b32: String,
    pub otp_uri: String,
    /// Plaintext backup codes (show once, never stored in plaintext again).
    pub backup_codes: Vec<String>,
}

/// One backup-code record stored in the encrypted blob.
#[derive(Debug, Serialize, Deserialize)]
struct BackupCode {
    /// Argon2id PHC string of the plaintext code.
    hash: String,
    /// Unix timestamp when used, or `null` if still valid.
    used_at: Option<i64>,
}

// ── Confirmed flag helpers ────────────────────────────────────────────────────

/// Returns `true` when vault-level TOTP is configured *and* confirmed.
pub fn is_active(conn: &Connection) -> bool {
    conn.query_row(
        "SELECT value FROM vault_meta WHERE key = 'totp_confirmed'",
        [],
        |r| r.get::<_, i64>(0),
    )
    .map(|v| v != 0)
    .unwrap_or(false)
}

fn set_confirmed(conn: &Connection, confirmed: bool) -> Result<(), VaultError> {
    conn.execute(
        "INSERT OR REPLACE INTO vault_meta (key, value) VALUES ('totp_confirmed', ?1)",
        params![confirmed as i64],
    )?;
    Ok(())
}

// ── CRUD ──────────────────────────────────────────────────────────────────────

/// Generate 10 random 8-character alphanumeric backup codes.
/// Each code is Argon2id-hashed (PHC string) before being stored in the vault.
/// Returns `(plaintext_codes, encrypted_blob, nonce)`.
fn generate_backup_codes(vmk: &[u8; 32]) -> Result<(Vec<String>, Vec<u8>, [u8; 24]), VaultError> {
    // Light Argon2id params for backup codes (hashed at setup, not at every unlock).
    let params = Params::new(64 * 1024, 2, 2, None)
        .map_err(|e| VaultError::Crypto(format!("argon2 params: {e}")))?;
    let argon2 = Argon2::new(Algorithm::Argon2id, Version::V0x13, params);

    let mut plaintext_codes: Vec<String> = Vec::with_capacity(10);
    let mut records: Vec<BackupCode> = Vec::with_capacity(10);

    for _ in 0..10 {
        // H-05 fix: 8 random bytes → 13 base32 chars = 64 bits of entropy.
        // Previously 5 bytes (40 bits) was tractable for GPU offline brute-force;
        // 64 bits is not.
        let mut raw = [0u8; 8];
        OsRng.fill_bytes(&mut raw);
        let code = base32::encode(base32::Alphabet::RFC4648 { padding: false }, &raw)
            .chars()
            .take(13)
            .collect::<String>();

        let salt = SaltString::generate(&mut OsRng);
        let hash = argon2
            .hash_password(code.as_bytes(), &salt)
            .map_err(|e| VaultError::Crypto(format!("backup code hash: {e}")))?
            .to_string();

        plaintext_codes.push(code);
        records.push(BackupCode { hash, used_at: None });
    }

    let json = serde_json::to_vec(&records)
        .map_err(|e| VaultError::Crypto(format!("backup codes serialize: {e}")))?;
    let (backup_ct, backup_nonce) = xchacha20::encrypt(vmk, &json, b"totp-backup-aad-v1")?;
    Ok((plaintext_codes, backup_ct, backup_nonce))
}

/// Generate a new TOTP secret, encrypt it with `vmk`, and store it.
/// Replaces any existing (unconfirmed) setup row.
/// Returns setup info for QR code display including one-time backup codes.
/// Does NOT mark TOTP as active — call `confirm_setup` after first successful code.
pub fn begin_setup(
    conn: &Connection,
    vmk: &[u8; 32],
    account_label: &str,
    issuer: &str,
) -> Result<TotpSetupInfo, VaultError> {
    let mut secret_b32 = totp::generate_secret();
    let algorithm = "SHA256";
    let digits = 8;

    let otp_uri = format!(
        "otpauth://totp/{issuer}:{account_label}?secret={secret_b32}&issuer={issuer}&algorithm={algorithm}&digits={digits}&period=30"
    );

    let (ciphertext, nonce) = xchacha20::encrypt(vmk, secret_b32.as_bytes(), b"totp-secret-aad-v1")?;
    let (backup_ct, backup_nonce, backup_codes) = {
        let (codes, ct, n) = generate_backup_codes(vmk)?;
        (ct, n, codes)
    };

    let id = Uuid::new_v4().to_string();
    conn.execute("DELETE FROM otp_config", [])?;
    conn.execute(
        "INSERT INTO otp_config
             (id, encrypted_secret, secret_nonce, backup_codes, backup_nonce, created_at)
         VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
        params![id, ciphertext, nonce.as_slice(), backup_ct, backup_nonce.as_slice(), now()],
    )?;
    
    // Persist L5 parameters
    conn.execute("INSERT OR REPLACE INTO vault_meta (key, value) VALUES ('totp_algorithm', ?1)", params![algorithm])?;
    conn.execute("INSERT OR REPLACE INTO vault_meta (key, value) VALUES ('totp_digits', ?1)", params![digits as i64])?;
    
    set_confirmed(conn, false)?;

    let info = TotpSetupInfo { secret_b32: secret_b32.clone(), otp_uri, backup_codes };
    secret_b32.zeroize();
    Ok(info)
}

/// Verify a backup code, mark it used, and return `true` if valid.
/// A used code is permanently invalidated.
pub fn verify_backup_code(
    conn: &Connection,
    vmk: &[u8; 32],
    code: &str,
) -> Result<bool, VaultError> {
    let (backup_ct, backup_nonce_vec): (Vec<u8>, Vec<u8>) = conn.query_row(
        "SELECT backup_codes, backup_nonce FROM otp_config LIMIT 1",
        [],
        |r| Ok((r.get(0)?, r.get(1)?)),
    ).map_err(|_| VaultError::Auth("no TOTP config stored".into()))?;

    if backup_nonce_vec.len() != 24 {
        return Err(VaultError::Crypto("invalid backup nonce length".into()));
    }
    let mut nonce = [0u8; 24];
    nonce.copy_from_slice(&backup_nonce_vec);

    let json = xchacha20::decrypt(vmk, &backup_ct, &nonce, b"totp-backup-aad-v1")?;
    let mut records: Vec<BackupCode> = serde_json::from_slice(&json)
        .map_err(|e| VaultError::Crypto(format!("backup codes deserialize: {e}")))?;

    // Argon2id params must match what was used at generation time
    let params = Params::new(64 * 1024, 2, 2, None)
        .map_err(|e| VaultError::Crypto(format!("argon2 params: {e}")))?;
    let argon2 = Argon2::new(Algorithm::Argon2id, Version::V0x13, params);

    for record in records.iter_mut() {
        if record.used_at.is_some() {
            continue; // already consumed
        }
        let parsed_hash = PasswordHash::new(&record.hash)
            .map_err(|e| VaultError::Crypto(format!("parse backup hash: {e}")))?;
        if argon2.verify_password(code.as_bytes(), &parsed_hash).is_ok() {
            record.used_at = Some(now());
            // Re-encrypt the updated records
            let updated_json = serde_json::to_vec(&records)
                .map_err(|e| VaultError::Crypto(format!("backup codes serialize: {e}")))?;
            let (new_ct, new_nonce) = xchacha20::encrypt(vmk, &updated_json, b"totp-backup-aad-v1")?;
            conn.execute(
                "UPDATE otp_config SET backup_codes = ?1, backup_nonce = ?2",
                params![new_ct, new_nonce.as_slice()],
            )?;
            return Ok(true);
        }
    }
    Ok(false)
}

/// Decrypt and return the stored TOTP configuration.
pub fn load(conn: &Connection, vmk: &[u8; 32]) -> Result<TotpConfig, VaultError> {
    let (id, ciphertext, nonce_vec): (String, Vec<u8>, Vec<u8>) = conn.query_row(
        "SELECT id, encrypted_secret, secret_nonce FROM otp_config LIMIT 1",
        [],
        |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
    ).map_err(|_| VaultError::Auth("no TOTP config stored".into()))?;

    if nonce_vec.len() != 24 {
        return Err(VaultError::Crypto("invalid TOTP secret nonce length".into()));
    }
    let mut nonce = [0u8; 24];
    nonce.copy_from_slice(&nonce_vec);

    let mut plaintext = xchacha20::decrypt(vmk, &ciphertext, &nonce, b"totp-secret-aad-v1")?;
    let secret_b32 = String::from_utf8(plaintext.clone())
        .map_err(|_| VaultError::Crypto("TOTP secret is not valid UTF-8".into()))?;
    plaintext.zeroize();

    Ok(TotpConfig { id, secret_b32, created_at: 0 })
}

pub fn get_params(conn: &Connection) -> (totp_rs::Algorithm, usize) {
    let algo_str = conn.query_row(
        "SELECT value FROM vault_meta WHERE key = 'totp_algorithm'",
        [],
        |r| r.get::<_, String>(0),
    ).unwrap_or("SHA1".into());
    
    let digits = conn.query_row(
        "SELECT value FROM vault_meta WHERE key = 'totp_digits'",
        [],
        |r| r.get::<_, i64>(0),
    ).unwrap_or(6) as usize;
    
    let algo = match algo_str.as_str() {
        "SHA256" => totp_rs::Algorithm::SHA256,
        "SHA512" => totp_rs::Algorithm::SHA512,
        _ => totp_rs::Algorithm::SHA1,
    };
    
    (algo, digits)
}

/// Confirm TOTP setup by verifying the first code.
/// Sets `totp_confirmed = 1` in vault_meta on success.
pub fn confirm_setup(
    conn: &Connection,
    vmk: &[u8; 32],
    code: &str,
) -> Result<(), VaultError> {
    let cfg = load(conn, vmk)?;
    let (algo, digits) = get_params(conn);
    let valid = totp::verify(&cfg.secret_b32, code, algo, digits)?;
    if !valid {
        return Err(VaultError::Auth("invalid TOTP code".into()));
    }
    set_confirmed(conn, true)
}

/// Verify a TOTP code against the stored secret.
/// Used at unlock time when TOTP is active.
pub fn verify_code(
    conn: &Connection,
    vmk: &[u8; 32],
    code: &str,
) -> Result<(), VaultError> {
    let cfg = load(conn, vmk)?;
    let (algo, digits) = get_params(conn);
    let valid = totp::verify(&cfg.secret_b32, code, algo, digits)?;
    if !valid {
        return Err(VaultError::Auth("invalid TOTP code".into()));
    }
    Ok(())
}

/// Disable and remove vault-level TOTP.
/// Requires a valid current code to prevent accidental removal.
pub fn remove(
    conn: &Connection,
    vmk: &[u8; 32],
    code: &str,
) -> Result<(), VaultError> {
    verify_code(conn, vmk, code)?;
    conn.execute("DELETE FROM otp_config", [])?;
    set_confirmed(conn, false)?;
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;
    use tempfile::NamedTempFile;
    use crate::vault::db::open_vault;

    fn open() -> (NamedTempFile, Connection) {
        let f = NamedTempFile::new().unwrap();
        let c = open_vault(f.path(), &[0xAAu8; 32]).unwrap();
        (f, c)
    }

    const VMK: [u8; 32] = [0x42u8; 32];

    #[test]
    fn totp_not_active_on_fresh_vault() {
        let (_f, c) = open();
        assert!(!is_active(&c));
    }

    #[test]
    fn begin_setup_returns_valid_uri() {
        let (_f, c) = open();
        let info = begin_setup(&c, &VMK, "test@vault.local", "VaultManager").unwrap();
        assert!(info.otp_uri.starts_with("otpauth://totp/"));
        assert!(info.otp_uri.contains(&info.secret_b32));
        assert!(!is_active(&c), "not yet confirmed");
    }

    #[test]
    fn confirm_setup_with_valid_code_activates_totp() {
        let (_f, c) = open();
        begin_setup(&c, &VMK, "user", "Vault").unwrap();
        // Load the secret and generate a valid code
        let cfg = load(&c, &VMK).unwrap();
        let (algo, digits) = get_params(&c);
        let code = totp::current_code(&cfg.secret_b32, algo, digits).unwrap();
        confirm_setup(&c, &VMK, &code).unwrap();
        assert!(is_active(&c));
    }

    #[test]
    fn confirm_setup_with_wrong_code_fails() {
        let (_f, c) = open();
        begin_setup(&c, &VMK, "user", "Vault").unwrap();
        let result = confirm_setup(&c, &VMK, "000000");
        // Allow spurious match (astronomically unlikely but not impossible)
        if let Err(e) = result {
            assert!(e.to_string().contains("invalid TOTP"));
        }
    }

    #[test]
    fn remove_with_valid_code_deactivates_totp() {
        let (_f, c) = open();
        begin_setup(&c, &VMK, "user", "Vault").unwrap();
        let cfg = load(&c, &VMK).unwrap();
        let (algo, digits) = get_params(&c);
        let code = totp::current_code(&cfg.secret_b32, algo, digits).unwrap();
        confirm_setup(&c, &VMK, &code).unwrap();
        assert!(is_active(&c));
        let (algo, digits) = get_params(&c);
        let code2 = totp::current_code(&cfg.secret_b32, algo, digits).unwrap();
        remove(&c, &VMK, &code2).unwrap();
        assert!(!is_active(&c));
    }

    #[test]
    fn begin_setup_twice_replaces_previous() {
        let (_f, c) = open();
        begin_setup(&c, &VMK, "user", "Vault").unwrap();
        begin_setup(&c, &VMK, "user", "Vault").unwrap();
        let count: i64 = c.query_row(
            "SELECT COUNT(*) FROM otp_config", [], |r| r.get(0),
        ).unwrap();
        assert_eq!(count, 1, "second setup must replace first");
    }

    #[test]
    fn begin_setup_returns_ten_backup_codes() {
        let (_f, c) = open();
        let info = begin_setup(&c, &VMK, "user", "Vault").unwrap();
        assert_eq!(info.backup_codes.len(), 10);
        for code in &info.backup_codes {
            assert_eq!(code.len(), 13, "backup code must be 13 chars (64-bit entropy)");
            assert!(code.chars().all(|ch| ch.is_ascii_alphanumeric()), "code must be alphanumeric: {code}");
        }
    }

    #[test]
    fn backup_code_verify_valid_then_consumed() {
        let (_f, c) = open();
        let info = begin_setup(&c, &VMK, "user", "Vault").unwrap();
        let code = &info.backup_codes[0];
        // First use: valid
        assert!(verify_backup_code(&c, &VMK, code).unwrap());
        // Second use of same code: consumed
        assert!(!verify_backup_code(&c, &VMK, code).unwrap());
    }

    #[test]
    fn backup_code_wrong_code_returns_false() {
        let (_f, c) = open();
        begin_setup(&c, &VMK, "user", "Vault").unwrap();
        assert!(!verify_backup_code(&c, &VMK, "XXXXXXXX").unwrap());
    }
}
