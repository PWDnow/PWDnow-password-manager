//! Key Encapsulation Mechanism (KEM) for VMK backup copies.

use hkdf::Hkdf;
use rand_core::OsRng;
use sha2::Sha256;
use x25519_dalek::{EphemeralSecret, PublicKey, StaticSecret};
use zeroize::{Zeroize, ZeroizeOnDrop};

use crate::error::VaultError;

// ── Trait ─────────────────────────────────────────────────────────────────────

pub trait KeyEncapsulator: Send + Sync {
    fn encapsulate(&self, recipient_pub: &[u8]) -> Result<(Vec<u8>, SharedSecret), VaultError>;
    fn decapsulate(&self, ciphertext: &[u8], sk: &[u8]) -> Result<SharedSecret, VaultError>;
}

/// A 32-byte shared secret that zeroizes on drop.
#[derive(ZeroizeOnDrop)]
pub struct SharedSecret([u8; 32]);

impl SharedSecret {
    pub fn as_bytes(&self) -> &[u8; 32] { &self.0 }
}

// ── X25519 (classical) ────────────────────────────────────────────────────────

pub struct X25519Kem;

impl KeyEncapsulator for X25519Kem {
    fn encapsulate(&self, recipient_pub: &[u8]) -> Result<(Vec<u8>, SharedSecret), VaultError> {
        if recipient_pub.len() != 32 {
            return Err(VaultError::Crypto("X25519: recipient_pub must be 32 bytes".into()));
        }
        let mut pk_bytes = [0u8; 32];
        pk_bytes.copy_from_slice(recipient_pub);
        let recipient = PublicKey::from(pk_bytes);

        let ephemeral_sk = EphemeralSecret::random_from_rng(OsRng);
        let ephemeral_pk = PublicKey::from(&ephemeral_sk);
        let dh = ephemeral_sk.diffie_hellman(&recipient);

        let shared = x25519_hkdf(dh.as_bytes(), b"vault-x25519-kem-v1")?;
        Ok((ephemeral_pk.as_bytes().to_vec(), shared))
    }

    fn decapsulate(&self, ciphertext: &[u8], sk: &[u8]) -> Result<SharedSecret, VaultError> {
        if ciphertext.len() != 32 {
            return Err(VaultError::Crypto("X25519: ciphertext must be 32 bytes".into()));
        }
        if sk.len() != 32 {
            return Err(VaultError::Crypto("X25519: secret key must be 32 bytes".into()));
        }
        let mut sk_bytes = [0u8; 32];
        sk_bytes.copy_from_slice(sk);
        let static_sk = StaticSecret::from(sk_bytes);

        let mut ct_bytes = [0u8; 32];
        ct_bytes.copy_from_slice(ciphertext);
        let sender_pk = PublicKey::from(ct_bytes);
        let dh = static_sk.diffie_hellman(&sender_pk);

        x25519_hkdf(dh.as_bytes(), b"vault-x25519-kem-v1")
    }
}

fn x25519_hkdf(dh_output: &[u8], info: &[u8]) -> Result<SharedSecret, VaultError> {
    let hk = Hkdf::<Sha256>::new(Some(b"vault-x25519-kem-salt"), dh_output);
    let mut out = [0u8; 32];
    hk.expand(info, &mut out)
        .map_err(|_| VaultError::Crypto("X25519 HKDF expand failed".into()))?;
    Ok(SharedSecret(out))
}

// ── X25519 + ML-KEM hybrid ────────────────────────────────────────────────────

#[cfg(feature = "pq-hybrid-1024")]
pub mod hybrid {
    use super::*;
    use ml_kem::{MlKem768, MlKem1024, EncapsulationKey, DecapsulationKey, Encapsulate, Decapsulate};
    use sha3::Sha3_512;

    pub const X25519_LEN: usize = 32;
    pub const ML768_EK_LEN: usize = 1184;
    pub const ML768_CT_LEN: usize = 1088;
    pub const ML1024_EK_LEN: usize = 1568;
    pub const ML1024_CT_LEN: usize = 1568;

    pub struct X25519MlKem768Kem;

    impl KeyEncapsulator for X25519MlKem768Kem {
        fn encapsulate(&self, recipient_pub: &[u8]) -> Result<(Vec<u8>, SharedSecret), VaultError> {
            let mut x_pk_bytes = [0u8; 32];
            x_pk_bytes.copy_from_slice(&recipient_pub[..32]);
            let recipient_x = PublicKey::from(x_pk_bytes);
            let eph_sk = EphemeralSecret::random_from_rng(OsRng);
            let eph_pk = PublicKey::from(&eph_sk);
            let x_ss = eph_sk.diffie_hellman(&recipient_x);

            let ek_bytes: &[u8; ML768_EK_LEN] = recipient_pub[32..].try_into().unwrap();
            let ek = EncapsulationKey::<MlKem768>::new(ek_bytes.into())
                .map_err(|_| VaultError::Crypto("ML-KEM-768 invalid EK".into()))?;
            
            // Use rand 0.8 StdRng which implements CryptoRng correctly
            use rand::{SeedableRng, rngs::StdRng};
            let mut rng = StdRng::from_entropy();
            let (ct, mlkem_ss) = ek.encapsulate_with_rng(&mut rng);

            let ml_ss: [u8; 32] = *mlkem_ss.as_slice();
            let shared = combine_secrets(x_ss.as_bytes(), &ml_ss, b"vault-hybrid-kem-v1")?;

            let mut ciphertext = eph_pk.as_bytes().to_vec();
            ciphertext.extend_from_slice(ct.as_ref());
            Ok((ciphertext, shared))
        }

        fn decapsulate(&self, ciphertext: &[u8], sk: &[u8]) -> Result<SharedSecret, VaultError> {
            let mut x_sk_bytes = [0u8; 32];
            x_sk_bytes.copy_from_slice(&sk[..32]);
            let static_sk = StaticSecret::from(x_sk_bytes);
            let mut eph_pk_bytes = [0u8; 32];
            eph_pk_bytes.copy_from_slice(&ciphertext[..32]);
            let eph_pk = PublicKey::from(eph_pk_bytes);
            let x_ss = static_sk.diffie_hellman(&eph_pk);

            let dk_seed: &[u8; 64] = sk[32..32+64].try_into().unwrap();
            let dk = DecapsulationKey::<MlKem768>::from_seed((*dk_seed).into());
            let ct_bytes: &[u8; ML768_CT_LEN] = ciphertext[32..].try_into().unwrap();
            let ct = ml_kem::Ciphertext::<MlKem768>::from(*ct_bytes);
            let mlkem_ss = dk.decapsulate(&ct);

            let ml_ss: [u8; 32] = *mlkem_ss.as_slice();
            combine_secrets(x_ss.as_bytes(), &ml_ss, b"vault-hybrid-kem-v1")
        }
    }

    pub struct X25519MlKem1024Kem;

    impl KeyEncapsulator for X25519MlKem1024Kem {
        fn encapsulate(&self, recipient_pub: &[u8]) -> Result<(Vec<u8>, SharedSecret), VaultError> {
            let mut x_pk_bytes = [0u8; 32];
            x_pk_bytes.copy_from_slice(&recipient_pub[..32]);
            let recipient_x = PublicKey::from(x_pk_bytes);
            let eph_sk = EphemeralSecret::random_from_rng(OsRng);
            let eph_pk = PublicKey::from(&eph_sk);
            let x_ss = eph_sk.diffie_hellman(&recipient_x);

            let ek_bytes: &[u8; ML1024_EK_LEN] = recipient_pub[32..].try_into().unwrap();
            let ek = EncapsulationKey::<MlKem1024>::new(ek_bytes.into())
                .map_err(|_| VaultError::Crypto("ML-KEM-1024 invalid EK".into()))?;
            
            use rand::{SeedableRng, rngs::StdRng};
            let mut rng = StdRng::from_entropy();
            let (ct, mlkem_ss) = ek.encapsulate_with_rng(&mut rng);

            let ml_ss: [u8; 32] = *mlkem_ss.as_slice();
            let shared = combine_secrets(x_ss.as_bytes(), &ml_ss, b"vault-hybrid-kem-v2-mlkem1024")?;

            let mut ciphertext = eph_pk.as_bytes().to_vec();
            ciphertext.extend_from_slice(ct.as_ref());
            Ok((ciphertext, shared))
        }

        fn decapsulate(&self, ciphertext: &[u8], sk: &[u8]) -> Result<SharedSecret, VaultError> {
            let mut x_sk_bytes = [0u8; 32];
            x_sk_bytes.copy_from_slice(&sk[..32]);
            let static_sk = StaticSecret::from(x_sk_bytes);
            let mut eph_pk_bytes = [0u8; 32];
            eph_pk_bytes.copy_from_slice(&ciphertext[..32]);
            let eph_pk = PublicKey::from(eph_pk_bytes);
            let x_ss = static_sk.diffie_hellman(&eph_pk);

            let dk_seed: &[u8; 64] = sk[32..32+64].try_into().unwrap();
            let dk = DecapsulationKey::<MlKem1024>::from_seed((*dk_seed).into());
            let ct_bytes: &[u8; ML1024_CT_LEN] = ciphertext[32..].try_into().unwrap();
            let ct = ml_kem::Ciphertext::<MlKem1024>::from(*ct_bytes);
            let mlkem_ss = dk.decapsulate(&ct);

            let ml_ss: [u8; 32] = *mlkem_ss.as_slice();
            combine_secrets(x_ss.as_bytes(), &ml_ss, b"vault-hybrid-kem-v2-mlkem1024")
        }
    }

    fn combine_secrets(x_ss: &[u8], mlkem_ss: &[u8], info: &[u8]) -> Result<SharedSecret, VaultError> {
        let mut ikm = Vec::with_capacity(x_ss.len() + mlkem_ss.len());
        ikm.extend_from_slice(x_ss);
        ikm.extend_from_slice(mlkem_ss);
        let hk = Hkdf::<Sha3_512>::new(None, &ikm);
        let mut out = [0u8; 32];
        hk.expand(info, &mut out)
            .map_err(|_| VaultError::Crypto("hybrid KEM HKDF expand failed".into()))?;
        Ok(SharedSecret(out))
    }
}

// ── Factory ───────────────────────────────────────────────────────────────────

pub fn default_kem() -> Box<dyn KeyEncapsulator> {
    #[cfg(feature = "pq-hybrid-1024")]
    { Box::new(hybrid::X25519MlKem1024Kem) }
    #[cfg(not(feature = "pq-hybrid-1024"))]
    { Box::new(X25519Kem) }
}

// ── Tests ─────────────────────────────────────────────────────────────────────

#[cfg(test)]
mod tests {
    use super::*;

    fn x25519_keypair() -> ([u8; 32], [u8; 32]) {
        let sk = StaticSecret::random_from_rng(OsRng);
        let pk = PublicKey::from(&sk);
        (*sk.as_bytes(), *pk.as_bytes())
    }

    #[test]
    fn x25519_kem_roundtrip() {
        let (sk, pk) = x25519_keypair();
        let kem = X25519Kem;
        let (ct, ss1) = kem.encapsulate(&pk).unwrap();
        let ss2 = kem.decapsulate(&ct, &sk).unwrap();
        assert_eq!(ss1.as_bytes(), ss2.as_bytes());
    }
}
