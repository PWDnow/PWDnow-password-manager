# PWDnow root gitignore

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.~lock.*#

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
**/*.rs.bk

# ── Vault data (SENSITIVE — never commit) ─────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db.meta
*.meta
*.tmp
*.wipe_tmp
*.lock
!Cargo.lock
.master_key
auth_data/
/vault/
daemon_data/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
build/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc

# ── Agent / AI tooling artifacts ──────────────────────────────────────────────
.claude/
.claude-flow/
web/.claude-flow/
.swarm/
.gemini/
.mcp.json
web/.superpowers/

# ── SSL certs (dev-only, never commit) ────────────────────────────────────────
web/ssl/

# ── Test results & coverage ───────────────────────────────────────────────────
web/test-results/
web/coverage/
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────────────────────
web/logs/
*.log

# ── Scratch / debug (one-off, not production) ────────────────────────────────
web/scratch/
web/debug_*.cjs
web/debug_*.mjs
web/debug_*.js
web/fix*.mjs
web/find_remaining_a11y.cjs
web/migrate_*.mjs
web/refactor_fetch.py

# ── Lighthouse reports ────────────────────────────────────────────────────────
web/lighthouse-*.json

# ── Graphify AST cache ────────────────────────────────────────────────────────
graphify-out/
web/graphify-out/cache/

# ── gRPC tokens (SENSITIVE) ──────────────────────────────────────────────────
daemon/grpc.token
*.token

# ── Obsidian ──────────────────────────────────────────────────────────────────
*.AppImage

# ── Internal security/audit docs (never public — vuln roadmap for attackers) ──
docs/flaws.md
docs/pentest-report.md
web/FOLDER_BUG.md
web/p2w-flaw.md
web/MASTER_SECURITY_REPORT.md
web/SECURITY_AUDIT_REPORT.md
web/need-fix.md
